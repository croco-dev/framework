# Croco Framework - Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# cp .env.example .env
#
# Most packages work without any env vars in development.
# Fill in only what your integration requires.
# Keep real credentials in your deployment secret store, never in this file.

# ── Telemetry ──────────────────────────────────────────────────────────────
# OTLP endpoint for distributed tracing (OpenTelemetry)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name shown in traces
# OTEL_SERVICE_NAME=my-service

# Sampling probability: 1.0 = 100%, 0.1 = 10%
# OTEL_SAMPLING_PROBABILITY=1.0

# Set to false to preserve telemetry configuration without starting the SDK or exporter
# TELEMETRY_ENABLED=false

# Trace-specific OTLP endpoint; overrides OTEL_EXPORTER_OTLP_ENDPOINT
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ── Croco CLI operations ──────────────────────────────────────────────────
# Base URL used by `croco jobs` when --url is omitted
# CROCO_JOBS_URL=http://localhost:3000

# ── HTTP operational endpoints ────────────────────────────────────────────
# Diagnostics exposure: off, private, or token. Prefer createApp diagnostics options for new code.
# CROCO_DIAGNOSTICS_EXPOSURE=off

# Legacy diagnostics opt-in. Prefer CROCO_DIAGNOSTICS_EXPOSURE for new code.
# CROCO_DIAGNOSTICS_ENABLED=false

# Secret checked through X-Diagnostics-Token when diagnostics exposure is token
# CROCO_DIAGNOSTICS_TOKEN=<croco-secret:CROCO_DIAGNOSTICS_TOKEN>

# Development inspector exposure: off, private, token, or custom
# CROCO_DEV_INSPECTOR_EXPOSURE=off

# Legacy development inspector opt-in for non-production environments
# CROCO_DEV_INSPECTOR_ENABLED=false

# Secret checked through X-Dev-Inspector-Token when inspector exposure is token
# CROCO_DEV_INSPECTOR_TOKEN=<croco-secret:CROCO_DEV_INSPECTOR_TOKEN>

# ── Runtime validation ────────────────────────────────────────────────────
# Enable framework-context dependency validation; false or 0 disables it
# CROCO_DI_VALIDATE=true

# HTTP dependency validation mode: off, warn, or enforce
# CROCO_HTTP_DI_VALIDATION=enforce

# HTTP security middleware validation mode: off, warn, or enforce
# CROCO_HTTP_SECURITY_VALIDATION=enforce

# ── Database (tx-drizzle) ───────────────────────────────────────────────────
# DATABASE_URL=<croco-secret:DATABASE_URL>

# ── Redis / Upstash (metering, ratelimit) ──────────────────────────────────
# UPSTASH_REDIS_REST_URL=<croco-secret:UPSTASH_REDIS_REST_URL>
# UPSTASH_REDIS_REST_TOKEN=<croco-secret:UPSTASH_REDIS_REST_TOKEN>

# ── Billing (billing-polar) ────────────────────────────────────────────────
# POLAR_ACCESS_TOKEN=<croco-secret:POLAR_ACCESS_TOKEN>
# POLAR_WEBHOOK_SECRET=<croco-secret:POLAR_WEBHOOK_SECRET>

# ── Auth ───────────────────────────────────────────────────────────────────
# CLERK_SECRET_KEY=<croco-secret:CLERK_SECRET_KEY>
# CLERK_PUBLISHABLE_KEY=<croco-config:CLERK_PUBLISHABLE_KEY>

# ── AWS (lambda-secrets, lambda-s3, etc.) ──────────────────────────────────
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=<croco-secret:AWS_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<croco-secret:AWS_SECRET_ACCESS_KEY>

# ── Node environment ───────────────────────────────────────────────────────
# NODE_ENV=development
