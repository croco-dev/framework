# Croco Framework - Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# cp .env.example .env
#
# Most packages work without any env vars in development.
# Fill in only what your integration requires.

# ── Telemetry ──────────────────────────────────────────────────────────────
# OTLP endpoint for distributed tracing (OpenTelemetry)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name shown in traces
# OTEL_SERVICE_NAME=my-service

# Sampling probability: 1.0 = 100%, 0.1 = 10%
# OTEL_SAMPLING_PROBABILITY=1.0

# ── Database (tx-drizzle) ───────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ── Redis / Upstash (metering, ratelimit) ──────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── Billing (billing-polar) ────────────────────────────────────────────────
# POLAR_ACCESS_TOKEN=your-polar-access-token
# POLAR_WEBHOOK_SECRET=your-webhook-secret

# ── Auth ───────────────────────────────────────────────────────────────────
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...

# ── AWS (lambda-secrets, lambda-s3, etc.) ──────────────────────────────────
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Node environment ───────────────────────────────────────────────────────
# NODE_ENV=development
