{
  "name": "croco",
  "private": true,
  "scripts": {
    "architecture:check:circular": "pnpm exec madge --circular --extensions ts packages",
    "architecture:check:circular:allowlist": "node --experimental-strip-types scripts/verify-circular-allowlist.mts",
    "architecture-policy:check": "pnpm --filter @croco/architecture-policy... build && node --experimental-strip-types scripts/architecture-policy-check.mts --manifest croco.arch.json",
    "build": "turbo build",
    "setup": "pnpm install && pnpm build && pnpm typecheck && pnpm test",
    "audit:prod": "pnpm audit --audit-level high --prod",
    "audit:read-only": "pnpm tracked-files:guard --recovery 'Use the failing check output to run its explicit writer or fix command' -- pnpm check && pnpm tracked-files:guard --recovery 'Fix the reported circular dependency' -- pnpm architecture:check:circular && pnpm tracked-files:guard --recovery 'pnpm bench:update' -- pnpm bench:check",
    "security:audit-policy": "node --experimental-strip-types scripts/dependency-audit-policy.mts",
    "check": "pnpm verification-policy:check && pnpm package-manifests:check && pnpm docs:catalog:check && pnpm provider-certification:check && pnpm docs:api-triggers:check && pnpm problem-registry:check && pnpm docs:examples:check && pnpm release-docs:check && pnpm ci-executables:check && pnpm architecture-policy:check && pnpm architecture:check:circular:allowlist && pnpm dependency-boundaries:check && pnpm security-allowlists:check && pnpm generated-secret-placeholders:check && pnpm strict-contract-typecheck && pnpm static-misuse:check && pnpm public-api:check && oxlint . && oxfmt --check . --ignore-path=.gitignore --ignore-path=.prettierignore --ignore-path=.oxfmtignore",
    "changeset": "changeset",
    "deploy": "turbo deploy",
    "dev": "turbo dev",
    "doctor": "pnpm --filter @croco/cli... build && node packages/cli/dist/bin/croco.js doctor",
    "docs:build": "turbo run docs:build",
    "docs:api:check": "node --experimental-strip-types scripts/api-docs-drift-check.mts",
    "docs:dev": "turbo run docs:dev",
    "docs:api-triggers:check": "node --experimental-strip-types scripts/api-docs-trigger-check.mts --check",
    "docs:api-triggers:write": "node --experimental-strip-types scripts/api-docs-trigger-check.mts --write",
    "docs:examples:check": "node --experimental-strip-types scripts/doc-examples-check.mts --check",
    "docs:examples:write": "node --experimental-strip-types scripts/doc-examples-check.mts --write",
    "format": "oxfmt --write . --ignore-path=.gitignore --ignore-path=.prettierignore --ignore-path=.oxfmtignore",
    "lint": "turbo lint",
    "prepare": "lefthook install",
    "release": "pnpm build && changeset publish",
    "test": "turbo test",
    "test:coverage:core": "pnpm --filter @croco/problems-core --filter @croco/telemetry-api --filter @croco/tenant-core --filter @croco/dataloader-core --filter @croco/ratelimit-core --filter @croco/llm-core --filter @croco/storage-core --filter @croco/architecture-policy build && CORE_COVERAGE=true SKIP_ENV_VALIDATION=true pnpm --filter @croco/framework-context --filter @croco/problems-core --filter @croco/protocols-core --filter @croco/protocols-rest --filter @croco/openapi-spec --filter @croco/rpc-codegen --filter @croco/transports-http --filter @croco/telemetry-api --filter @croco/telemetry-sdk-node --filter @croco/tx-core --filter @croco/tx-drizzle --filter @croco/events-core --filter @croco/events-tx --filter @croco/retry-core --filter @croco/idempotency-core --filter @croco/testing --filter create-croco-app --filter @croco/cli --filter @croco/auth-core exec vitest run --coverage --config ../../vitest.config.ts",
    "test:coverage:core:warning": "node --experimental-strip-types scripts/core-coverage-warning-check.mts",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version",
    "bench:check": "node --experimental-strip-types scripts/bench-threshold-check.mts",
    "bench:readiness": "node --experimental-strip-types scripts/benchmark-readiness-report.mts",
    "bench:update": "node --experimental-strip-types scripts/bench-threshold-check.mts --update-baseline",
    "alpha-release:smoke": "node --experimental-strip-types scripts/alpha-release-smoke.mts",
    "changeset-required:check": "node --experimental-strip-types scripts/changeset-required-check.mts",
    "ci-executables:check": "node --experimental-strip-types scripts/ci-executable-policy.mts",
    "create-croco-app:smoke": "node --experimental-strip-types scripts/create-croco-app-generated-smoke.mts",
    "generated-secret-placeholders:check": "node --experimental-strip-types scripts/generated-secret-placeholder-policy.mts",
    "docs:catalog:check": "node --experimental-strip-types scripts/package-docs-check.mts --check",
    "docs:catalog:write": "node --experimental-strip-types scripts/package-docs-check.mts --write",
    "dependency-boundaries:check": "node --experimental-strip-types scripts/package-quality-report.mts --boundary-check-only",
    "first-success:verify": "pnpm build --filter=create-croco-app && node --experimental-strip-types scripts/first-success-verify.mts",
    "package-quality:report": "node --experimental-strip-types scripts/package-quality-report.mts",
    "provider-certification:check": "node --experimental-strip-types scripts/provider-certification-check.mts",
    "production-ready:check": "node --experimental-strip-types scripts/production-ready-check.mts",
    "spine-promotion:check": "node --experimental-strip-types scripts/spine-promotion-check.mts",
    "problem-registry:check": "node --experimental-strip-types scripts/problem-registry.mts --check",
    "problem-registry:write": "node --experimental-strip-types scripts/problem-registry.mts --write",
    "public-api:check": "node --experimental-strip-types scripts/public-api-surface.mts --check",
    "public-api:write": "node --experimental-strip-types scripts/public-api-surface.mts --write",
    "quick-start-lambda:smoke": "node --experimental-strip-types scripts/quick-start-lambda-smoke.mts",
    "saas-billing-golden-path:smoke": "pnpm --filter @croco-example/saas-billing-golden-path... build && pnpm --filter @croco-example/saas-billing-golden-path test",
    "package-entrypoints:smoke": "node --experimental-strip-types scripts/package-entrypoint-smoke.mts",
    "package-bins:smoke": "node --experimental-strip-types scripts/package-bin-smoke.mts",
    "package-manifests:check": "node scripts/normalize-packages.mjs --check",
    "package-manifests:write": "node scripts/normalize-packages.mjs --write",
    "pr-review-companion": "node --experimental-strip-types scripts/pr-review-companion.mts",
    "release-docs:check": "node --experimental-strip-types scripts/release-docs-check.mts",
    "release:spine-evidence": "node --experimental-strip-types scripts/release-spine-evidence.mts",
    "security-allowlists:check": "node --experimental-strip-types scripts/security-allowlist-metadata-check.mts",
    "static-misuse:check": "node --experimental-strip-types scripts/static-misuse-check.mts",
    "strict-contract-typecheck": "node --experimental-strip-types scripts/strict-contract-typecheck.mts",
    "tracked-files:guard": "node --experimental-strip-types scripts/tracked-file-mutation-guard.mts",
    "verification-policy:check": "node --experimental-strip-types scripts/verification-policy.mts"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.26"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@swc/core": "1.15.43",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.0.16",
    "lefthook": "2.0.13",
    "madge": "8.0.0",
    "oxfmt": "*",
    "oxlint": "*",
    "tsup": "8.5.1",
    "turbo": "latest",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
