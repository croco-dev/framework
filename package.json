{
  "name": "croco",
  "private": true,
  "scripts": {
    "architecture:check:circular": "pnpm exec madge --circular --extensions ts packages",
    "architecture:check:circular:allowlist": "node --experimental-strip-types scripts/verification-command.mts --id architecture-circular-allowlist",
    "architecture-policy:check": "pnpm --filter @croco/architecture-policy... build && node --experimental-strip-types scripts/verification-command.mts --id architecture-policy",
    "build": "turbo build",
    "setup": "pnpm install --frozen-lockfile && pnpm build && pnpm typecheck && pnpm test",
    "setup:update": "pnpm install --no-frozen-lockfile && pnpm build && pnpm typecheck && pnpm test",
    "audit:prod": "pnpm audit --audit-level high --prod",
    "audit:read-only": "pnpm verify:repo",
    "security:audit-policy": "node --experimental-strip-types scripts/verification-command.mts --id dependency-audit-policy",
    "security:gitleaks-smoke": "node --experimental-strip-types scripts/security-gitleaks-smoke.mts",
    "check": "pnpm verify:repo",
    "changeset": "changeset",
    "deploy": "turbo deploy",
    "dev": "turbo dev",
    "doctor": "pnpm --filter @croco/cli... build && node packages/cli/dist/bin/croco.js doctor",
    "docs:build": "turbo run docs:build",
    "docs:api:check": "node --experimental-strip-types scripts/api-docs-drift-check.mts",
    "docs:dev": "turbo run docs:dev",
    "docs:api-triggers:check": "node --experimental-strip-types scripts/verification-command.mts --id docs-api-triggers",
    "docs:api-triggers:write": "node --experimental-strip-types scripts/api-docs-trigger-check.mts --write",
    "docs:examples:check": "node --experimental-strip-types scripts/verification-command.mts --id docs-examples",
    "docs:examples:write": "node --experimental-strip-types scripts/doc-examples-check.mts --write",
    "format": "oxfmt --write . --ignore-path=.gitignore --ignore-path=.prettierignore --ignore-path=.oxfmtignore",
    "lint": "turbo lint",
    "prepare": "lefthook install",
    "release": "pnpm build && changeset publish",
    "test": "turbo test",
    "test:release-gates": "node --experimental-strip-types scripts/verification-command.mts --id release-gate-tests",
    "test-evidence:bundle": "node --experimental-strip-types scripts/test-evidence-bundle.mts",
    "test-inventory:check": "node --experimental-strip-types scripts/test-inventory.mts --check",
    "test-inventory:write": "node --experimental-strip-types scripts/test-inventory.mts --write",
    "test:lane": "node --experimental-strip-types scripts/test-lane-runner.mts",
    "test:live:resources": "vitest run scripts/tests/live-tests-workflow.spec.ts",
    "assurance:report": "node --experimental-strip-types scripts/executable-assurance-report.mts",
    "test:coverage:core": "pnpm --filter @croco/problems-core --filter @croco/telemetry-api --filter @croco/tenant-core --filter @croco/dataloader-core --filter @croco/ratelimit-core --filter @croco/llm-core --filter @croco/storage-core --filter @croco/architecture-policy build && node --experimental-strip-types scripts/verification-command.mts --id core-coverage",
    "test:coverage:core:warning": "node --experimental-strip-types scripts/verification-command.mts --id core-coverage-warning",
    "typecheck": "turbo typecheck",
    "version-packages": "node --experimental-strip-types scripts/version-packages.mts",
    "bench:check": "node --experimental-strip-types scripts/bench-threshold-check.mts",
    "bench:readiness": "node --experimental-strip-types scripts/benchmark-readiness-report.mts",
    "bench:update": "node --experimental-strip-types scripts/bench-threshold-check.mts --update-baseline",
    "branch-protection:check": "node --experimental-strip-types scripts/branch-protection-policy.mts",
    "alpha-release:smoke": "node --experimental-strip-types scripts/verification-command.mts --id alpha-release-smoke",
    "changeset-required:check": "node --experimental-strip-types scripts/verification-command.mts --id changeset-required",
    "ci-executables:check": "node --experimental-strip-types scripts/verification-command.mts --id ci-executables",
    "ci-cacheable-lanes:collect": "node --experimental-strip-types scripts/ci-cacheable-lanes-collector.mts --repo croco-dev/framework --cohort-start-at 2026-08-15T03:49:21.000Z --output ci-reports/ci-observations",
    "ci-cacheable-lanes:evaluate": "pnpm ci-cacheable-lanes:collect && node --experimental-strip-types scripts/ci-cacheable-lanes-evaluator.mts --input ci-reports/ci-observations",
    "ci-cacheable-lanes:identity": "node --experimental-strip-types scripts/ci-cacheable-experiment-identity.mts",
    "ci-cacheable-lanes:producer": "node --experimental-strip-types scripts/ci-cacheable-lane-runner.mts",
    "ci-cacheable-lanes:security": "node --experimental-strip-types scripts/ci-cacheable-security-evidence.mts",
    "ci-cacheable-lanes:assemble": "node --experimental-strip-types scripts/ci-synthesis-input.mts",
    "ci-cacheable-lanes:synthesize": "node --experimental-strip-types scripts/ci-split-validation-synthesis.mts",
    "ci-cacheable-lanes:local": "node --experimental-strip-types scripts/ci-cacheable-lanes-local-harness.mts",
    "ci-performance:evaluate": "node --experimental-strip-types scripts/ci-publish-critical-path.mts",
    "compiler-baseline:check": "node --experimental-strip-types scripts/verification-command.mts --id compiler-baseline",
    "create-croco-app:smoke": "node --experimental-strip-types scripts/create-croco-app-generated-smoke.mts",
    "generated-secret-placeholders:check": "node --experimental-strip-types scripts/verification-command.mts --id generated-secret-placeholders",
    "docs:catalog:check": "node --experimental-strip-types scripts/verification-command.mts --id docs-catalog",
    "docs:catalog:write": "node --experimental-strip-types scripts/package-docs-check.mts --write",
    "dependency-boundaries:check": "node --experimental-strip-types scripts/verification-command.mts --id dependency-boundaries",
    "decorator-signature-spike:check": "node --experimental-strip-types scripts/verification-command.mts --id decorator-signature-spike",
    "first-success:verify": "pnpm build --filter=create-croco-app && node --experimental-strip-types scripts/verification-command.mts --id first-success",
    "package-quality:report": "node --experimental-strip-types scripts/verification-command.mts --id spine-bundle-size",
    "provider-certification:check": "node --experimental-strip-types scripts/verification-command.mts --id provider-certification",
    "production-ready:check": "node --experimental-strip-types scripts/verification-command.mts --id production-ready",
    "spine-promotion:check": "node --experimental-strip-types scripts/verification-command.mts --id spine-promotion",
    "problem-registry:check": "node --experimental-strip-types scripts/verification-command.mts --id problem-registry",
    "problem-registry:write": "node --experimental-strip-types scripts/problem-registry.mts --write",
    "public-api:check": "node --experimental-strip-types scripts/verification-command.mts --id public-api",
    "public-api:write": "node --experimental-strip-types scripts/public-api-surface.mts --write",
    "quick-start-lambda:smoke": "node --experimental-strip-types scripts/verification-command.mts --id quick-start-lambda-smoke",
    "saas-billing-golden-path:smoke": "pnpm --filter @croco-example/saas-billing-golden-path... build && pnpm --filter @croco-example/saas-billing-golden-path test",
    "package-entrypoints:smoke": "node --experimental-strip-types scripts/verification-command.mts --id package-entrypoints-smoke",
    "package-bins:smoke": "node --experimental-strip-types scripts/verification-command.mts --id package-bins-smoke",
    "package-manifests:check": "node --experimental-strip-types scripts/verification-command.mts --id package-manifests",
    "package-manifests:write": "node scripts/normalize-packages.mjs --write",
    "pr-review-companion": "node --experimental-strip-types scripts/pr-review-companion.mts",
    "release-docs:check": "node --experimental-strip-types scripts/verification-command.mts --id release-docs",
    "release-version-sync:check": "node --experimental-strip-types scripts/verification-command.mts --id release-version-sync",
    "release-version-sync:write": "node --experimental-strip-types scripts/release-version-sync.mts --write",
    "release:spine-evidence": "pnpm verify:spine",
    "verify:repo": "node --experimental-strip-types scripts/release-spine-evidence.mts --profile repo",
    "verify:spine": "node --experimental-strip-types scripts/release-spine-evidence.mts --profile spine",
    "verify:publish": "node --experimental-strip-types scripts/release-spine-evidence.mts --profile publish",
    "security-allowlists:check": "node --experimental-strip-types scripts/verification-command.mts --id security-allowlists",
    "static-misuse:check": "node --experimental-strip-types scripts/verification-command.mts --id static-misuse",
    "strict-contract-typecheck": "node --experimental-strip-types scripts/verification-command.mts --id strict-contract-typecheck",
    "tracked-files:guard": "node --experimental-strip-types scripts/tracked-file-mutation-guard.mts",
    "verification-policy:check": "node --experimental-strip-types scripts/verification-command.mts --id verification-policy"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.26"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@changesets/parse": "0.4.2",
    "@swc/core": "1.15.43",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.1.8",
    "lefthook": "2.0.13",
    "madge": "8.0.0",
    "oxfmt": "*",
    "oxlint": "*",
    "semver": "7.7.4",
    "smol-toml": "1.7.0",
    "tsup": "8.5.1",
    "turbo": "2.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
