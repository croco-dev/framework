{
  "name": "croco",
  "private": true,
  "scripts": {
    "architecture:check:circular": "npx --yes madge --circular --extensions ts packages",
    "architecture:check:circular:allowlist": "node --experimental-strip-types scripts/verify-circular-allowlist.mts",
    "architecture-policy:check": "pnpm --filter @croco/architecture-policy... build && node --experimental-strip-types scripts/architecture-policy-check.mts --manifest croco.arch.json",
    "build": "turbo build",
    "setup": "pnpm install && pnpm build && pnpm typecheck && pnpm test",
    "audit:prod": "pnpm audit --audit-level high --prod",
    "check": "pnpm package-manifests:check && pnpm docs:catalog:check && pnpm docs:api-triggers:check && pnpm problem-registry:check && pnpm docs:examples:check && pnpm release-docs:check && pnpm architecture-policy:check && pnpm architecture:check:circular:allowlist && pnpm dependency-boundaries:check && pnpm strict-contract-typecheck && pnpm static-misuse:check && pnpm public-api:check && oxlint . && oxfmt --check . --ignore-path=.gitignore --ignore-path=.prettierignore --ignore-path=.oxfmtignore",
    "changeset": "changeset",
    "deploy": "turbo deploy",
    "dev": "turbo dev",
    "doctor": "pnpm --filter @croco/cli... build && node packages/cli/dist/bin/croco.js doctor",
    "docs:build": "turbo run docs:build",
    "docs:dev": "turbo run docs:dev",
    "docs:api-triggers:check": "node --experimental-strip-types scripts/api-docs-trigger-check.mts --check",
    "docs:api-triggers:write": "node --experimental-strip-types scripts/api-docs-trigger-check.mts --write",
    "docs:examples:check": "node --experimental-strip-types scripts/doc-examples-check.mts --check",
    "docs:examples:write": "node --experimental-strip-types scripts/doc-examples-check.mts --write",
    "format": "oxfmt --write . --ignore-path=.gitignore --ignore-path=.prettierignore --ignore-path=.oxfmtignore",
    "lint": "turbo lint",
    "prepare": "lefthook install",
    "release": "pnpm build && changeset publish",
    "test": "turbo test",
    "test:coverage:core": "CORE_COVERAGE=true SKIP_ENV_VALIDATION=true pnpm --filter @croco/framework-context --filter @croco/retry-core --filter @croco/events-core --filter @croco/auth-core --filter @croco/telemetry-api exec vitest run --coverage --config ../../vitest.config.ts",
    "test:coverage:core:warning": "node --experimental-strip-types scripts/core-coverage-warning-check.mts",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version",
    "bench:check": "node --experimental-strip-types scripts/bench-threshold-check.mts",
    "bench:readiness": "node --experimental-strip-types scripts/benchmark-readiness-report.mts",
    "bench:update": "node --experimental-strip-types scripts/bench-threshold-check.mts --update-baseline",
    "alpha-release:smoke": "node --experimental-strip-types scripts/alpha-release-smoke.mts",
    "changeset-required:check": "node --experimental-strip-types scripts/changeset-required-check.mts",
    "create-croco-app:smoke": "node --experimental-strip-types scripts/create-croco-app-generated-smoke.mts",
    "docs:catalog:check": "node --experimental-strip-types scripts/package-docs-check.mts --check",
    "docs:catalog:write": "node --experimental-strip-types scripts/package-docs-check.mts --write",
    "dependency-boundaries:check": "node --experimental-strip-types scripts/package-quality-report.mts --boundary-check-only",
    "first-success:verify": "node --experimental-strip-types scripts/first-success-verify.mts",
    "package-quality:report": "node --experimental-strip-types scripts/package-quality-report.mts",
    "production-ready:check": "node --experimental-strip-types scripts/production-ready-check.mts",
    "problem-registry:check": "node --experimental-strip-types scripts/problem-registry.mts --check",
    "problem-registry:write": "node --experimental-strip-types scripts/problem-registry.mts --write",
    "public-api:check": "node --experimental-strip-types scripts/public-api-surface.mts --check",
    "public-api:write": "node --experimental-strip-types scripts/public-api-surface.mts --write",
    "quick-start-lambda:smoke": "node --experimental-strip-types scripts/quick-start-lambda-smoke.mts",
    "package-entrypoints:smoke": "node --experimental-strip-types scripts/package-entrypoint-smoke.mts",
    "package-bins:smoke": "node --experimental-strip-types scripts/package-bin-smoke.mts",
    "package-manifests:check": "node scripts/normalize-packages.mjs --check",
    "package-manifests:write": "node scripts/normalize-packages.mjs --write",
    "pr-review-companion": "node --experimental-strip-types scripts/pr-review-companion.mts",
    "release-docs:check": "node --experimental-strip-types scripts/release-docs-check.mts",
    "static-misuse:check": "node --experimental-strip-types scripts/static-misuse-check.mts",
    "strict-contract-typecheck": "node --experimental-strip-types scripts/strict-contract-typecheck.mts"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.26"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.0.16",
    "lefthook": "2.0.13",
    "oxfmt": "*",
    "oxlint": "*",
    "tsup": "8.5.1",
    "turbo": "latest",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "pnpm": {
    "overrides": {
      "@clerk/shared": "3.47.7",
      "@hono/node-server": "1.19.10",
      "@opentelemetry/auto-instrumentations-node": "0.76.0",
      "@opentelemetry/exporter-prometheus": "0.218.0",
      "@opentelemetry/sdk-node": "0.218.0",
      "@grpc/grpc-js": "1.14.4",
      "@isaacs/brace-expansion": "5.0.1",
      "@croco/auth-better-auth>@vitest/coverage-v8": "4.1.8",
      "@croco/auth-better-auth>vitest": "4.1.8",
      "@croco/frontend-vite>vite": "6.4.3",
      "anymatch>picomatch": "2.3.2",
      "astro>vite": "7.3.5",
      "axios": "1.16.1",
      "better-auth>next": "16.2.3",
      "better-auth>vitest": "4.1.8",
      "defu": "6.1.7",
      "eslint-plugin-import-x>minimatch": "10.2.3",
      "fast-xml-builder": "1.1.7",
      "flatted": "3.4.2",
      "glob": "11.1.0",
      "h3": "1.15.6",
      "js-cookie": "3.0.8",
      "kysely": "0.28.17",
      "lodash": "4.18.1",
      "miniflare>undici": "7.24.0",
      "path-to-regexp": "0.1.13",
      "picomatch": "4.0.4",
      "form-data": "4.0.6",
      "openai>ws": "8.21.0",
      "protobufjs": "7.6.1",
      "rollup": "4.59.0",
      "svgo": "4.0.1",
      "typedoc>minimatch": "9.0.7",
      "validator": "13.15.22",
      "vitest>vite": "7.3.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gv7w-rqvm-qjhr"
      ]
    }
  }
}
