{
  "plugins": ["typescript", "import", "react", "jest", "unicorn", "node"],
  "jsPlugins": [
    {
      "name": "@croco/oxlint-rules",
      "specifier": "./packages/oxlint-rules/src/index.ts"
    }
  ],
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-unused-vars": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-wrapper-object-types": "off",
    "no-unsafe-optional-chaining": "off",
    "no-undef": "off",
    "no-restricted-globals": "off",
    "@croco/oxlint-rules/no-cross-domain-import": "off",
    "@croco/oxlint-rules/no-datasource-import": "off",
    "@croco/oxlint-rules/rest-generated-contract-schema": "off",
    "@croco/oxlint-rules/type-graphql-explicit-type": "off"
  },
  "overrides": [
    {
      "files": ["**/*.hbs"],
      "rules": {}
    },
    {
      "files": [
        "scripts/fixtures/decorator-signature-spike/diagnostics.ts",
        "scripts/fixtures/decorator-signature-spike/negative.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["scripts/fixtures/decorator-signature-spike/prototype.snapshot.d.ts"],
      "rules": {
        "typescript/no-useless-empty-export": "off"
      }
    },
    {
      "files": ["packages/create-croco-app/templates/**/*.ts"],
      "rules": {
        "@croco/oxlint-rules/no-cross-domain-import": "error",
        "@croco/oxlint-rules/no-datasource-import": "error",
        "@croco/oxlint-rules/rest-generated-contract-schema": "error"
      }
    },
    {
      "files": [
        "packages/protocols-graphql/**/*.ts",
        "packages/transports-graphql/**/*.ts",
        "packages/create-croco-app/templates/addons/graphql*/**/*.ts",
        "packages/create-croco-app/templates/addons/lambda/apps/graphql-api/**/*.ts"
      ],
      "rules": {
        "@croco/oxlint-rules/type-graphql-explicit-type": "error"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-unused-vars": "off",
        "typescript/no-unused-vars": "off",
        "typescript/no-non-null-assertion": "off",
        "jest/no-conditional-expect": "off",
        "jest/valid-expect": "off",
        "jest/no-standalone-expect": "off",
        "jest/require-to-throw-message": "off",
        "jest/expect-expect": "off",
        "react/no-children-prop": "off"
      }
    }
  ]
}
