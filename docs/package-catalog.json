    "promotion": {
      "packages": {
        "cli": {
          "owner": "operator-tooling",
          "targetEvidence": [
            {
              "description": "croco doctor behavior",
              "role": "behavior",
              "commandId": "test",
              "testPath": "src/tests/doctor.spec.ts"
            },
            {
              "description": "CLI contract compatibility",
              "role": "compatibility",
              "commandId": "test",
              "testPath": "src/tests/contractsCheck.spec.ts"
            },
            {
              "description": "stable diagnostic recovery codes",
              "role": "failure-recovery",
              "commandId": "test",
              "testPath": "src/tests/diagnosticCodes.spec.ts"
            }
          ],
          "recoveryAction": "Complete CLI spine-readiness diagnostics and smoke evidence, then move cli from maturity.beta.packages to maturity.production.packages when production-ready:check passes."
        },
        "create-croco-app": {
          "owner": "generated-app-tooling",
          "targetEvidence": [
