{
  "name": "@croco-example/research-recruitment",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/admin-core": "workspace:*",
    "@croco/engagement-core": "workspace:*",
    "@croco/research-core": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
