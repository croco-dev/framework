{
  "name": "@croco-example/page-experience",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsrs --noEmit",
    "typecheck": "tsrs --noEmit",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/admin-react": "workspace:*",
    "@croco/analytics-core": "workspace:*",
    "@croco/frontend-react": "workspace:*",
    "@croco/metrics-core": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
