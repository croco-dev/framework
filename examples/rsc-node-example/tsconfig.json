{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.tsx",
    "performance/**/*.tsx",
    "performance/**/*.ts",
    "performance/profile.mjs",
    "vite.config.ts"
  ]
}
