{
  "name": "@croco-example/lifecycle-journey",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/tests/TaskRecovery.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "start": "tsx src/index.ts",
    "dev": "pnpm build:browser && tsx src/server.ts",
    "build:browser": "tsup"
  },
  "dependencies": {
    "@croco/admin-core": "workspace:*",
    "@croco/admin-react": "workspace:*",
    "@croco/execution-core": "workspace:*",
    "@croco/lifecycle-core": "workspace:*",
    "@croco/tasks-core": "workspace:*",
    "@croco/triggers-core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
