{
  "name": "@croco-example/cancellation-flow",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build:browser": "tsup",
    "dev": "pnpm build:browser && tsx src/server.ts",
    "test": "vitest run src/tests",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json"
  },
  "dependencies": {
    "@croco/admin-core": "workspace:*",
    "@croco/admin-react": "workspace:*",
    "@croco/billing-core": "workspace:*",
    "@croco/billing-drizzle": "workspace:*",
    "@croco/frontend-react": "workspace:*",
    "@croco/idempotency-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
