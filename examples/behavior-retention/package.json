    "@croco/testing-resources": "workspace:*",
    "@croco/warehouse-core": "workspace:*",
    "@croco/warehouse-postgres": "workspace:*",
    "pg": "8.22.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
