{
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/tests/**",
    "**/type-tests/**",
    "packages/*/scripts/**",
    "packages/create-croco-app/templates/**"
  ],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  }
}
