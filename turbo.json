{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalPassThroughEnv": ["CROCO_TEST_EVIDENCE_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "deploy": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "docs:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/packages/oxlint-rules/src/**"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["build", "^build", "^test"]
    },
    "@croco/docs#test": {
      "cache": true,
      "dependsOn": ["^build", "^test"]
    },
    "@croco/oxlint-rules#test": {
      "cache": true
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["build", "^build", "^typecheck"]
    },
    "@croco/docs#typecheck": {
      "cache": true,
      "dependsOn": ["^build", "^typecheck"]
    }
  }
}
