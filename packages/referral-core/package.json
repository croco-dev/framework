{
  "name": "@croco/referral-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/referral-core"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./credit-grant": {
      "types": {
        "import": "./dist/credit-grant.d.mts",
        "require": "./dist/credit-grant.d.ts"
      },
      "import": "./dist/credit-grant.mjs",
      "require": "./dist/credit-grant.js"
    },
    "./link-token": {
      "types": {
        "import": "./dist/link-token.d.mts",
        "require": "./dist/link-token.d.ts"
      },
      "import": "./dist/link-token.mjs",
      "require": "./dist/link-token.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./credit-grant": {
        "types": {
          "import": "./dist/credit-grant.d.mts",
          "require": "./dist/credit-grant.d.ts"
        },
        "import": "./dist/credit-grant.mjs",
        "require": "./dist/credit-grant.js"
      },
      "./link-token": {
        "types": {
          "import": "./dist/link-token.d.mts",
          "require": "./dist/link-token.d.ts"
        },
        "import": "./dist/link-token.mjs",
        "require": "./dist/link-token.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/credit-grant.ts src/link-token.ts --format esm,cjs --minify --clean --dts --external @croco/credits-core --no-splitting",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/credits-core": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@croco/credits-core": "workspace:*"
  }
}
