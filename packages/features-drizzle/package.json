{
  "name": "@croco/features-drizzle",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/features-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run src/tests/DrizzleExperimentStore.spec.ts src/tests/ExperimentSchema.spec.ts src/tests/FeaturesSchema.spec.ts src/tests/ScheduledPolicyPublisher.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:live": "vitest run src/tests/DrizzlePolicyReleaseStore.postgres.spec.ts src/tests/DrizzleExperimentStore.postgres.spec.ts",
    "test:postgres": "vitest run src/tests/DrizzlePolicyReleaseStore.postgres.spec.ts src/tests/DrizzleExperimentStore.postgres.spec.ts",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/execution-core": "workspace:*",
    "@croco/features-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/triggers-core": "workspace:*",
    "@croco/triggers-qstash": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-orm": "catalog:",
    "pg": "8.22.0",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
