{
  "name": "@croco/framework-logger",
  "version": "0.0.2",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/framework-config": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "pino-pretty": "^13.1.3"
  }
}
