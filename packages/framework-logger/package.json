{
  "name": "@croco/framework-logger",
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/framework-config": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@croco/utils-tsconfig": "workspace:*",
    "@types/node": "^22",
    "pino-pretty": "^13.1.3"
  },
  "publishConfig": {
    "access": "public",
    "files": [
      "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "exports": {
      ".": {
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  }
}
