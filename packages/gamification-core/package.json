{
  "name": "@croco/gamification-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/gamification-core"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./reward-contracts": {
      "types": "./dist/reward-contracts.d.ts",
      "import": "./dist/reward-contracts.mjs",
      "require": "./dist/reward-contracts.js"
    },
    "./mission-validation": {
      "types": "./dist/mission-validation.d.ts",
      "import": "./dist/mission-validation.mjs",
      "require": "./dist/mission-validation.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./reward-contracts": {
        "types": "./dist/reward-contracts.d.ts",
        "import": "./dist/reward-contracts.mjs",
        "require": "./dist/reward-contracts.js"
      },
      "./mission-validation": {
        "types": "./dist/mission-validation.d.ts",
        "import": "./dist/mission-validation.mjs",
        "require": "./dist/mission-validation.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/reward-contracts.ts src/mission-validation.ts --format esm,cjs --minify --clean --dts --splitting --external @croco/gamification-core/reward-contracts && node scripts/verify-built-reward-entrypoints.mjs",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts",
    "dev": "tsup src/index.ts src/reward-contracts.ts src/mission-validation.ts --format cjs,esm --dts --watch --splitting --external @croco/gamification-core/reward-contracts"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  }
}
