{
  "name": "@croco/protocols-core",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/protocols-core"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typedi": "0.10.0",
    "vitest": "4.1.8"
  },
  "vitest": {
    "include": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ]
  }
}
