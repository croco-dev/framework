{
  "name": "@croco/esbuild-plugin",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@croco/utils-tsconfig": "workspace:*",
    "esbuild": "^0.20.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "esbuild": ">=0.17.0",
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
