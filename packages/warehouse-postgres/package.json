{
  "name": "@croco/warehouse-postgres",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/warehouse-postgres"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.mjs",
      "require": "./dist/metrics.js"
    },
    "./facts": {
      "types": "./dist/facts.d.ts",
      "import": "./dist/facts.mjs",
      "require": "./dist/facts.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.mjs",
      "require": "./dist/pipeline.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./metrics": {
        "types": "./dist/metrics.d.ts",
        "import": "./dist/metrics.mjs",
        "require": "./dist/metrics.js"
      },
      "./facts": {
        "types": "./dist/facts.d.ts",
        "import": "./dist/facts.mjs",
        "require": "./dist/facts.js"
      },
      "./pipeline": {
        "types": "./dist/pipeline.d.ts",
        "import": "./dist/pipeline.mjs",
        "require": "./dist/pipeline.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/metrics.ts src/facts.ts src/pipeline.ts --format esm,cjs --minify --clean --dts",
    "dev": "tsup src/index.ts src/metrics.ts src/facts.ts src/pipeline.ts --format esm,cjs --dts --watch",
    "test": "vitest run src/tests/PostgresMetricsStore.spec.ts src/tests/PostgresWarehouseCatalog.spec.ts src/tests/PostgresWarehouseReader.spec.ts src/tests/PostgresWarehouseWriter.spec.ts src/tests/CompilePostgresMetric.spec.ts src/tests/PostgresMetricRead.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:integration": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/Pipeline.integration.spec.ts src/tests/PostgresMetricRead.integration.spec.ts src/tests/PostgresWarehouseFacts.integration.spec.ts src/tests/PostgresWarehouseReader.integration.spec.ts",
    "test:live": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/PostgresMetricsStore.integration.spec.ts",
    "test:real": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/*.integration.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/metrics-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/warehouse-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/etl-core": "workspace:*",
    "@croco/execution-core": "workspace:*",
    "@croco/execution-drizzle": "workspace:*",
    "@croco/testing-resources": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-orm": "catalog:",
    "pg": "8.22.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@croco/etl-core": "workspace:*",
    "@croco/execution-core": "workspace:*",
    "@croco/execution-drizzle": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "8.22.0"
  },
  "peerDependenciesMeta": {
    "@croco/etl-core": {
      "optional": true
    },
    "@croco/execution-core": {
      "optional": true
    },
    "@croco/execution-drizzle": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
