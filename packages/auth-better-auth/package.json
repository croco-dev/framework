{
  "name": "@croco/auth-better-auth",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/auth-better-auth"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/auth-core": "workspace:*",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/idempotency-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/tx-drizzle": "workspace:*",
    "@croco/webhooks-core": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "catalog:",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@croco/testing": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  }
}
