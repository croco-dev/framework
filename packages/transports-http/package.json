{
  "name": "@croco/transports-http",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "@croco/ratelimit-core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@types/aws-lambda": "^8.10.0",
    "hono": "^4.12.15",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@hono/node-server": "^1.0.0",
    "vitest": "4.0.16"
  },
  "vitest": {
    "include": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ]
  }
}
