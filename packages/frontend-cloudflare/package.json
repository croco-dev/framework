{
  "name": "@croco/frontend-cloudflare",
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/frontend-cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "exports": {
    ".": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/worker.js",
    "types": "./dist/worker.d.ts",
    "exports": {
      ".": {
        "import": "./dist/worker.js",
        "require": "./dist/worker.cjs",
        "types": "./dist/worker.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/meta-vite": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@croco/frontend-react": "workspace:*",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {},
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  }
}
