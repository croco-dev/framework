{
  "name": "@croco/frontend-cloudflare",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "dev": "wrangler dev",
    "publish": "pnpm build && npx wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "peerDependencies": {},
  "dependencies": {
    "@croco/meta-vite": "workspace:*"
  },
  "devDependencies": {
    "@croco/frontend-react": "workspace:*",
    "@cloudflare/workers-types": "^4.20250214.0",
    "vitest": "^4.0.16"
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/worker.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/worker.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
