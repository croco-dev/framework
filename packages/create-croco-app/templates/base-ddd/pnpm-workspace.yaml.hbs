packages:
  - "apps/**/*"
  - "!apps/**/.next/**"
  - "libs/**/*"

overrides:
  postcss: 8.5.18
  "@graphql-tools/utils@<=12.0.0": 12.0.3
  sharp: 0.35.4

patchedDependencies:
  tsup@8.5.1: patches/tsup@8.5.1.patch

allowBuilds:
  "@apollo/protobufjs": true
  "@clerk/shared": true
  esbuild: true
  lefthook: true
  protobufjs: true
  sharp: true
  unrs-resolver: true

onlyBuiltDependencies:
  - "@apollo/protobufjs"
  - "@clerk/shared"
  - esbuild
  - lefthook
  - protobufjs
  - sharp
  - unrs-resolver
