export const saasContractRoutes = [
  { routeId: 'SaasController.seedDemo', operationId: 'seedSaasDemo', methodName: 'seedDemo', method: 'POST', path: '/saas/demo/seed' },
  { routeId: 'SaasController.smokeDemo', operationId: 'smokeSaasDemo', methodName: 'smokeDemo', method: 'GET', path: '/saas/demo/smoke' }
] as const;
export const saasKeys = {
  all: () => ['saas'] as const,
  seedDemo: () => [...saasKeys.all(), 'seedDemo'] as const,
  smokeDemo: () => [...saasKeys.all(), 'smokeDemo'] as const,
};
export const saasInvalidationManifest = {
  seedDemo: { route: saasContractRoutes[0], invalidates: [saasKeys.all()] },
} as const;

export function createSaasClient(config: RpcClientConfig = {}) {
  return {
    seedDemo: (options?: RpcClientRequestOptions): Promise<SeedDemoOutput> => {
      const request = createRpcClientRequest(saasContractRoutes[0], 'mutation', '/saas/demo/seed', { method: 'POST' }, options, config);
      return request.fetch(request.url, request.init).catch((error) => handleRpcRequestError(error, request.telemetry)).then((response) => handleJsonResponse<SeedDemoOutput>(response, request.telemetry));
    },
    seedDemoResult: (options?: RpcClientRequestOptions): Promise<SeedDemoResult> => {
      const request = createRpcClientRequest(saasContractRoutes[0], 'mutation', '/saas/demo/seed', { method: 'POST' }, options, config);
      return request.fetch(request.url, request.init).then((response) => handleJsonResult<SeedDemoOutput, SeedDemoProblem>(response, seedDemoProblemDeclarations, request.telemetry), (error) => handleRpcRequestResultError(error, request.telemetry));
    },
    smokeDemo: (options?: RpcClientRequestOptions): Promise<SmokeDemoOutput> => {
      const request = createRpcClientRequest(saasContractRoutes[1], 'query', '/saas/demo/smoke', { method: 'GET' }, options, config);
      return request.fetch(request.url, request.init).catch((error) => handleRpcRequestError(error, request.telemetry)).then((response) => handleJsonResponse<SmokeDemoOutput>(response, request.telemetry));
    },
    smokeDemoResult: (options?: RpcClientRequestOptions): Promise<SmokeDemoResult> => {
      const request = createRpcClientRequest(saasContractRoutes[1], 'query', '/saas/demo/smoke', { method: 'GET' }, options, config);
      return request.fetch(request.url, request.init).then((response) => handleJsonResult<SmokeDemoOutput, SmokeDemoProblem>(response, smokeDemoProblemDeclarations, request.telemetry), (error) => handleRpcRequestResultError(error, request.telemetry));
    },
  };
}

export type SaasClient = ReturnType<typeof createSaasClient>;

export const saasClient = createSaasClient();
