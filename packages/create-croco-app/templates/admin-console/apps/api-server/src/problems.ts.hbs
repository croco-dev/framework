import { Problem, ProblemCategory } from "@croco/problems-core";

export class InvalidEnvironmentProblem extends Problem {
  readonly code = "starter/invalid-environment";
  readonly category = ProblemCategory.ValidationError;

  constructor(detail: string) {
    super(undefined, undefined, `Invalid environment: ${detail}`);
  }
}

export class UserNotFoundProblem extends Problem {
  readonly code = "starter/user-not-found";
  readonly category = ProblemCategory.NotFound;

  constructor(id: string) {
    super(undefined, undefined, `User ${id} was not found.`);
  }
}

export class AdminUserNotFoundProblem extends Problem {
  readonly code = "admin-console/user-not-found";
  readonly category = ProblemCategory.NotFound;

  constructor(id: string) {
    super(undefined, undefined, `Admin user ${id} was not found. Refresh the resource table or invite the user again.`);
  }
}

export class AdminCreditOperationsPermissionDeniedProblem extends Problem {
  readonly code = "admin-core/credit-operations-permission-denied";
  readonly category = ProblemCategory.Forbidden;

  constructor(detail: string) {
    super(undefined, undefined, detail);
  }
}
