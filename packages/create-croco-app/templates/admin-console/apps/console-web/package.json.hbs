{
  "name": "{{scope}}/console-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:smoke": "node --input-type=module --eval \"import { loadConfigFromFile } from 'vite'; const result = await loadConfigFromFile({ command: 'serve', mode: 'development' }, './vite.config.ts'); if (!result) throw new Error('vite.config.ts did not load');\"",
    "admin:smoke": "pnpm dev:smoke",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "{{scope}}/provider-rpc": "workspace:*",
    "@croco/admin-core": "workspace:*",
    "@croco/admin-react": "workspace:*",
    "@croco/frontend-problems": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@croco/frontend-vite": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
