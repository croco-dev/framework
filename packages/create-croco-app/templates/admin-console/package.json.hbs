{
  "name": "{{projectName}}",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter {{scope}}/api-server dev",
    "dev:web": "pnpm --filter {{scope}}/console-web dev",
    "dev:smoke": "pnpm contract:client && pnpm --filter {{scope}}/api-server dev:smoke && pnpm --filter {{scope}}/console-web dev:smoke",
    "admin:smoke": "pnpm contract:client && pnpm --filter {{scope}}/api-server admin:smoke && pnpm --filter {{scope}}/console-web admin:smoke",
    "contract:check": "croco-rpc-codegen --controllers 'apps/api-server/src/{controllers/**/*.ts,admin.ts,users.ts,problems.ts}' --check",
    "contract:snapshot": "croco contracts check --controllers 'apps/api-server/src/{controllers/**/*.ts,admin.ts,users.ts,problems.ts}' --json --out contract-graph.snapshot.json",
    "contract:diff": "croco contracts diff --baseline contract-graph.snapshot.json --controllers 'apps/api-server/src/{controllers/**/*.ts,admin.ts,users.ts,problems.ts}'",
    "contract:verify": "pnpm contract:diff && pnpm contract:openapi && pnpm contract:client && pnpm --filter {{scope}}/provider-rpc typecheck",
    "ci:contracts": "pnpm contract:verify",
    "contract:openapi": "pnpm contract:check && croco-openapi-spec --controllers 'apps/api-server/src/{controllers/**/*.ts,admin.ts,users.ts,problems.ts}' --out openapi.json --title '{{projectName}} Admin Console API' --version 0.1.0 --server http://localhost:3000",
    "contract:client": "pnpm contract:check && croco-rpc-codegen --controllers 'apps/api-server/src/{controllers/**/*.ts,admin.ts,users.ts,problems.ts}' --out libs/shared/provider-rpc/src --react-query && pnpm --filter {{scope}}/provider-rpc typecheck",
    "codegen": "pnpm contract:client",
    "build": "pnpm contract:client && turbo build",
    "lint": "biome lint .",
    "test": "turbo test",
    "typecheck": "pnpm contract:client && turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@croco/cli": "workspace:*",
    "@croco/openapi-spec": "workspace:*",
    "@croco/rpc-codegen": "workspace:*",
    "turbo": "latest",
    "typescript": "^5.8.0"
  }
}
