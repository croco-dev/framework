{
  "name": "{{scope}}/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch --onSuccess \"node dist/index.js\"",
    "di:generate": "tsx scripts/generate-di.ts",
    "profile:check": "pnpm di:generate && tsx src/provider-profile-check.ts --mode=manifest",
    "profile:smoke:real": "pnpm di:generate && tsx src/provider-profile-check.ts --mode=real-provider",
    "demo:seed": "pnpm di:generate && tsx src/demo/seed.ts",
    "demo:smoke": "pnpm di:generate && tsx src/demo/smoke.ts",
    "demo:scenario": "pnpm di:generate && tsx src/demo/scenario.ts",
    "demo:usage-recover": "pnpm di:generate && tsx src/demo/usage-recover.ts",
    "ops:smoke": "pnpm di:generate && tsx src/demo/ops-smoke.ts",
    "jobs:smoke": "pnpm di:generate && tsx src/demo/jobs-smoke.ts",
    "failure-drill:smoke": "pnpm di:generate && tsx src/demo/failure-drill-smoke.ts",
    "failure-drill:integration": "pnpm di:generate && tsx src/provider-profile-check.ts --mode=real-provider",
    "di:graph": "pnpm di:generate && cross-env NODE_OPTIONS=--import=tsx croco di graph --module src/app.ts --bootstrap createCrocoDiGraphApplication --roots createCrocoDiGraphRoots --write ../../.croco/build/di-graph.manifest.json",
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm di:generate && vitest run",
    "typecheck": "pnpm di:generate && tsc --noEmit"
  },
  "dependencies": {
    "@croco/access-core": "workspace:*",
    "@croco/ai-usage": "workspace:*",
    "@croco/auth-core": "workspace:*",
    "@croco/billing-core": "workspace:*",
    "@croco/billing-polar": "workspace:*",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/engagement-core": "workspace:*",
    "@croco/entitlements-core": "workspace:*",
    "@croco/execution-core": "workspace:*",
    "@croco/events-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-module": "workspace:*",
    "@croco/health-core": "workspace:*",
    "@croco/idempotency-core": "workspace:*",
    "@croco/invitation-core": "workspace:*",
    "@croco/lifecycle-core": "workspace:*",
    "@croco/membership-core": "workspace:*",
    "@croco/metering-core": "workspace:*",
    "@croco/notifications-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "@croco/ratelimit-core": "workspace:*",
    "@croco/storage-core": "workspace:*",
    "@croco/tasks-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*",
    "@croco/telemetry-sdk-node": "workspace:*",
    "@croco/tenant-core": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "@croco/tx-core": "workspace:*",
    "reflect-metadata": "0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@croco/cli": "workspace:*",
    "@croco/esbuild-plugin": "workspace:*",
    "@croco/testing": "workspace:*",
    "@croco/webhooks-core": "workspace:*",
    "@types/node": "^24",
    "cross-env": "^10.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
