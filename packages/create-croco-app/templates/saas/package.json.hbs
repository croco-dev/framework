{
  "name": "{{projectName}}",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:api": "pnpm --filter {{scope}}/api-server dev",
    "contract:check": "pnpm contract:client && pnpm --filter {{scope}}/provider-rpc typecheck",
    "contract:openapi": "pnpm contract:check && NODE_PATH=./node_modules croco-openapi-spec --controllers 'apps/api-server/src/controllers/**/*.ts' --out openapi.json --title '{{projectName}} SaaS API' --version 0.1.0 --server http://localhost:3000",
    "contract:client": "NODE_PATH=./node_modules node ./node_modules/@croco/rpc-codegen/dist/cli.js --controllers 'apps/api-server/src/controllers/**/*.ts' --out libs/shared/provider-rpc/src",
    "codegen": "pnpm contract:client",
    "demo:seed": "pnpm --filter {{scope}}/api-server demo:seed",
    "demo:smoke": "pnpm contract:check && pnpm --filter {{scope}}/api-server demo:smoke",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@croco/openapi-spec": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "@croco/rpc-codegen": "workspace:*",
    "turbo": "latest",
    "typescript": "^5.8.0",
    "zod": "^3.23.8"
  }
}
