    "@croco/frontend-cloudflare": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^20.10.6",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
