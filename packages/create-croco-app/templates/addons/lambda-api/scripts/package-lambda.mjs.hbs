import { rmSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
const root = fileURLToPath(new URL('../', import.meta.url));
function pnpm(args) {
  const result = spawnSync('corepack', ['pnpm', ...args], { cwd: root, stdio: 'inherit' });
  if (result.error) throw result.error;
  if (result.status !== 0) process.exit(result.status ?? 1);
}
pnpm(['--filter', '{{scope}}/api-server', 'build']);
rmSync(new URL('../.lambda-package/', import.meta.url), { recursive: true, force: true });
pnpm(['--filter', '{{scope}}/api-server', 'deploy', '--prod', '.lambda-package']);
console.log('Lambda deployment directory prepared. Run lambda:smoke and lambda:check before SAM packaging.');
