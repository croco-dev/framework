# Generated by create-croco-app.
# Copy this file to .env and uncomment only the variables your application uses.
# Keep .env and real credentials out of version control.
# Extend this template when you add integrations; use package documentation as the source of truth.

# -- API runtime --
# Runtime environment used for production defaults and telemetry sampling.
# NODE_ENV=development
# Port used by the generated Node API server.
# PORT=3000
# Browser origin allowed by the generated API CORS policy.
# WEB_ORIGIN=http://localhost:5173

# -- Telemetry --
# Enable OpenTelemetry exporter wiring.
# TELEMETRY_ENABLED=false
# OTLP endpoint used by telemetry init and flush.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional trace-specific OTLP endpoint that overrides the shared OTLP endpoint.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# -- Vite API client --
# Public API URL used by the generated Vite client.
# VITE_API_URL=http://localhost:3000
