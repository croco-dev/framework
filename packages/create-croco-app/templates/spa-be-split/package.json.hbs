{
  "name": "{{projectName}}",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter {{scope}}/api-server dev",
    "dev:web": "pnpm --filter {{scope}}/console-web dev",
    "codegen": "croco-rpc-codegen --controllers \"apps/api-server/src/controllers/**/*.ts\" --out libs/shared/provider-rpc/src --react-query",
    "typecheck": "turbo typecheck",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@croco/rpc-codegen": "workspace:*",
    "lefthook": "^1.7.0",
    "turbo": "latest",
    "typescript": "^5.8.0"
  }
}
