{
  "name": "{{projectName}}",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:api": "pnpm --filter {{scope}}/api-server dev",
    "dev:web": "pnpm --filter {{scope}}/console-web dev",
    "contract:check": "croco-rpc-codegen --controllers 'apps/api-server/src/controllers/**/*.ts' --check",
    "contract:snapshot": "croco contracts check --controllers 'apps/api-server/src/controllers/**/*.ts' --json --out contract-graph.snapshot.json",
    "contract:diff": "croco contracts diff --baseline contract-graph.snapshot.json --controllers 'apps/api-server/src/controllers/**/*.ts'",
    "contract:verify": "pnpm contract:diff && pnpm contract:openapi && pnpm contract:client && pnpm --filter {{scope}}/provider-rpc typecheck",
    "ci:contracts": "pnpm contract:verify",
    "contract:openapi": "pnpm contract:check && croco-openapi-spec --controllers 'apps/api-server/src/controllers/**/*.ts' --out openapi.json --title '{{projectName}} API' --version 0.1.0 --server http://localhost:3000",
    "contract:client": "pnpm contract:check && croco-rpc-codegen --controllers 'apps/api-server/src/controllers/**/*.ts' --out libs/shared/provider-rpc/src --react-query && pnpm --filter {{scope}}/provider-rpc typecheck",
    "codegen": "pnpm contract:client",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@croco/cli": "workspace:*",
    "@croco/openapi-spec": "workspace:*",
    "@croco/rpc-codegen": "workspace:*",
    "turbo": "latest",
    "typescript": "^5.8.0"
  }
}
