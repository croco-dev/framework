{
  "name": "{{projectName}}",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:api": "pnpm --filter {{scope}}/api-server dev",
    "dev:web": "pnpm --filter {{scope}}/console-web dev",
    "codegen": "croco-rpc-codegen --controllers 'apps/api-server/src/controllers/**/*.ts' --out libs/shared/provider-rpc/src",
    "build": "turbo build",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "turbo": "latest",
    "typescript": "^5.8.0"
  }
}
