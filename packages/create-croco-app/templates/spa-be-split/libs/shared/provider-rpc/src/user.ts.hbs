export function createUserQueries(client: UserClient = userClient) {
  return {
  list: (rpc?: RpcClientRequestOptions): ListQueryFactory => ({
    queryKey: userKeys.list(),
    queryFn: () => client.list(rpc),
  }),
  listResult: (rpc?: RpcClientRequestOptions): ListResultQueryFactory => ({
    queryKey: [...userKeys.list(), 'result'] as const,
    queryFn: () => client.listResult(rpc),
  }),
  getById: (input: GetByIdInput, rpc?: RpcClientRequestOptions): GetByIdQueryFactory => ({
    queryKey: userKeys.getById(input),
    queryFn: () => client.getById(input, rpc),
  }),
  getByIdResult: (input: GetByIdInput, rpc?: RpcClientRequestOptions): GetByIdResultQueryFactory => ({
    queryKey: [...userKeys.getById(input), 'result'] as const,
    queryFn: () => client.getByIdResult(input, rpc),
  }),
  };
}

