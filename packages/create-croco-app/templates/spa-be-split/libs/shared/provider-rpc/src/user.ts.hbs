      return request.fetch(request.url, request.init).catch((error) => handleRpcRequestError(error, request.telemetry)).then((response) => handleJsonResponse<ListOutput>(response, request.telemetry));
    },
    listResult: (options?: RpcClientRequestOptions): Promise<ListResult> => {
      const request = createRpcClientRequest(userContractRoutes[0], 'query', '/users', { method: 'GET' }, options, config);
      return request.fetch(request.url, request.init).then((response) => handleJsonResult<ListOutput, ListProblem>(response, listProblemDeclarations, request.telemetry), (error) => handleRpcRequestResultError(error, request.telemetry));
    },
    getById: (input: GetByIdInput, options?: RpcClientRequestOptions): Promise<GetByIdOutput> => {
      const path = (): string => `/users/${encodeRpcPathSegment(userContractRoutes[1], 'id', input.path.id)}`;
      const request = createRpcClientRequest(userContractRoutes[1], 'query', path, { method: 'GET' }, options, config);
      return request.fetch(request.url, request.init).catch((error) => handleRpcRequestError(error, request.telemetry)).then((response) => handleJsonResponse<GetByIdOutput>(response, request.telemetry));
    },
    getByIdResult: (input: GetByIdInput, options?: RpcClientRequestOptions): Promise<GetByIdResult> => {
      const path = (): string => `/users/${encodeRpcPathSegment(userContractRoutes[1], 'id', input.path.id)}`;
      const request = createRpcClientRequest(userContractRoutes[1], 'query', path, { method: 'GET' }, options, config);
      return request.fetch(request.url, request.init).then((response) => handleJsonResult<GetByIdOutput, GetByIdProblem>(response, getByIdProblemDeclarations, request.telemetry), (error) => handleRpcRequestResultError(error, request.telemetry));
    },
    create: (input: CreateInput, options?: RpcClientRequestOptions): Promise<CreateOutput> => {
      const request = createRpcClientRequest(userContractRoutes[2], 'mutation', '/users', { method: 'POST', body: JSON.stringify(input), headers: { 'Content-Type': 'application/json' } }, options, config);
      return request.fetch(request.url, request.init).catch((error) => handleRpcRequestError(error, request.telemetry)).then((response) => handleJsonResponse<CreateOutput>(response, request.telemetry));
    },
    createResult: (input: CreateInput, options?: RpcClientRequestOptions): Promise<CreateResult> => {
      const request = createRpcClientRequest(userContractRoutes[2], 'mutation', '/users', { method: 'POST', body: JSON.stringify(input), headers: { 'Content-Type': 'application/json' } }, options, config);
      return request.fetch(request.url, request.init).then((response) => handleJsonResult<CreateOutput, CreateProblem>(response, createProblemDeclarations, request.telemetry), (error) => handleRpcRequestResultError(error, request.telemetry));
    },
    update: (input: UpdateInput, options?: RpcClientRequestOptions): Promise<UpdateOutput> => {
      const path = (): string => `/users/${encodeRpcPathSegment(userContractRoutes[3], 'id', input.path.id)}`;
      const request = createRpcClientRequest(userContractRoutes[3], 'mutation', path, { method: 'PUT', body: JSON.stringify(input.body), headers: { 'Content-Type': 'application/json' } }, options, config);
      return request.fetch(request.url, request.init).catch((error) => handleRpcRequestError(error, request.telemetry)).then((response) => handleJsonResponse<UpdateOutput>(response, request.telemetry));
    },
    updateResult: (input: UpdateInput, options?: RpcClientRequestOptions): Promise<UpdateResult> => {
      const path = (): string => `/users/${encodeRpcPathSegment(userContractRoutes[3], 'id', input.path.id)}`;
      const request = createRpcClientRequest(userContractRoutes[3], 'mutation', path, { method: 'PUT', body: JSON.stringify(input.body), headers: { 'Content-Type': 'application/json' } }, options, config);
      return request.fetch(request.url, request.init).then((response) => handleJsonResult<UpdateOutput, UpdateProblem>(response, updateProblemDeclarations, request.telemetry), (error) => handleRpcRequestResultError(error, request.telemetry));
    },
    delete: (input: DeleteInput, options?: RpcClientRequestOptions): Promise<DeleteOutput> => {
      const path = (): string => `/users/${encodeRpcPathSegment(userContractRoutes[4], 'id', input.path.id)}`;
      const request = createRpcClientRequest(userContractRoutes[4], 'mutation', path, { method: 'DELETE' }, options, config);
