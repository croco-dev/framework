import { useState, type CSSProperties, type FormEvent } from 'react';
import { ProblemNotice } from './ProblemNotice';
import { useUsers } from './api/useUsers';

const projectName = '{{projectName}}';

const pageStyle: CSSProperties = {
  maxWidth: 720,
  margin: '4rem auto',
  fontFamily: 'system-ui, sans-serif',
};
const labelStyle: CSSProperties = { color: '#15803d', fontWeight: 700 };
const formStyle: CSSProperties = { display: 'grid', gap: 12, marginBlock: 24 };

export default function App() {
  const { users, loading, problem, createUser, refresh } = useUsers();
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    await createUser({ name, email });
    setName('');
    setEmail('');
  }

  return (
    <main style={pageStyle}>
      <p style={labelStyle}>Croco SPA + API</p>
      <h1>{projectName}</h1>
      <p>React SPA에서 Croco REST API 서버의 사용자 목록을 호출합니다.</p>

      <form onSubmit={handleSubmit} style={formStyle}>
        <input value={name} onChange={(event) => setName(event.target.value)} placeholder="User name" required />
        <input value={email} onChange={(event) => setEmail(event.target.value)} placeholder="Email" required />
        <button type="submit">Create user</button>
      </form>

      {loading ? <p>Loading users...</p> : null}
      {problem ? <ProblemNotice problem={problem} onRetry={() => void refresh()} /> : null}

      <ul>
        {users.map((user) => (
          <li key={user.id}>
            {user.name} — {user.email}
          </li>
        ))}
      </ul>
    </main>
  );
}
