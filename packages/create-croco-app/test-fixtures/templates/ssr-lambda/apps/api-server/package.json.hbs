{
  "name": "{{scope}}/api-server",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/lambda.ts --format esm --platform node --target node22 --out-dir ../../dist/api --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/frontend-react": "workspace:*",
    "@croco/meta-vite": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "@croco/ratelimit-core": "workspace:*",
    "@croco/repository-core": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22",
    "tsx": "^4.20.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  }
}
