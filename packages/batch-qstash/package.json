{
  "name": "@croco/batch-qstash",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croco/batch-core": "workspace:*",
    "@croco/execution-core": "workspace:*",
    "@upstash/qstash": "^2.0.0"
  },
  "devDependencies": {
    "@croco/utils-tsconfig": "workspace:*",
    "vitest": "^4.0.0",
    "tsup": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
