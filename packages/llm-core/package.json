{
  "name": "@croco/llm-core",
  "version": "0.0.3",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*",
    "ai": "^4.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "3.0.38",
    "@ai-sdk/openai": "3.0.26",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*"
  }
}
