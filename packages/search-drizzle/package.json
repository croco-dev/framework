{
  "name": "@croco/search-drizzle",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*",
    "@croco/search-core": "workspace:*",
    "@croco/framework-context": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "typescript": "5.9.3",
    "tsup": "8.5.1",
    "vitest": "4.0.16",
    "@types/node": "^22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts"
}
