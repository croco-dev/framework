exports[`generateDesktopPreloadBridges > generates deterministic minimal bridges for local window profiles only 1`] = `
[
  {
    "source": "import type { DesktopPreloadContextBridge, DesktopPreloadTransport } from "@croco/desktop-codegen";

type DesktopAbortRegistration = (abort: () => void) => () => void;

function invokeDesktopCommand(
  transport: DesktopPreloadTransport,
  commandId: string,
  input: unknown,
  registerAbort: DesktopAbortRegistration | undefined,
): Promise<unknown> {
  if (registerAbort === undefined) {
    return transport.invoke(commandId, input, {});
  }

  const controller = new AbortController();
  const unregister = registerAbort(() => controller.abort());
  try {
    return transport.invoke(commandId, input, { signal: controller.signal }).finally(unregister);
  } catch (error) {
    unregister();
    throw error;
  }
}

export function installDesktopPreloadBridge(
  contextBridge: DesktopPreloadContextBridge,
  transport: DesktopPreloadTransport,
): void {
  const bridge = Object.freeze({
    commands: Object.freeze({
    }),
    events: Object.freeze({
    }),
  });

  contextBridge.exposeInMainWorld("crocoDesktop", bridge);
}
",
    "windowId": "empty",
  },
  {
    "source": "import type { DesktopPreloadContextBridge, DesktopPreloadTransport } from "@croco/desktop-codegen";

type DesktopAbortRegistration = (abort: () => void) => () => void;

function invokeDesktopCommand(
  transport: DesktopPreloadTransport,
  commandId: string,
  input: unknown,
  registerAbort: DesktopAbortRegistration | undefined,
): Promise<unknown> {
  if (registerAbort === undefined) {
    return transport.invoke(commandId, input, {});
  }

  const controller = new AbortController();
  const unregister = registerAbort(() => controller.abort());
  try {
    return transport.invoke(commandId, input, { signal: controller.signal }).finally(unregister);
  } catch (error) {
    unregister();
    throw error;
  }
}

export function installDesktopPreloadBridge(
  contextBridge: DesktopPreloadContextBridge,
  transport: DesktopPreloadTransport,
): void {
  const bridge = Object.freeze({
    commands: Object.freeze({
      ["project"]: Object.freeze({
        ["open"]: (input: unknown, registerAbort?: DesktopAbortRegistration): Promise<unknown> =>
          invokeDesktopCommand(transport, "project.open", input, registerAbort),
      }),
      ["system"]: Object.freeze({
        ["status"]: (input: unknown, registerAbort?: DesktopAbortRegistration): Promise<unknown> =>
          invokeDesktopCommand(transport, "system.status", input, registerAbort),
      }),
    }),
    events: Object.freeze({
      ["project"]: Object.freeze({
        ["changed"]: (callback: (payload: unknown) => void): (() => void) =>
          transport.subscribe("project.changed", (payload) => callback(payload)),
      }),
      ["system"]: Object.freeze({
        ["ready"]: (callback: (payload: unknown) => void): (() => void) =>
          transport.subscribe("system.ready", (payload) => callback(payload)),
      }),
    }),
  });

  contextBridge.exposeInMainWorld("crocoDesktop", bridge);
}
",
    "windowId": "main",
  },
  {
