{
  "name": "@croco/entitlements-drizzle",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/entitlements-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/billing-core": "workspace:*",
    "@croco/entitlements-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/tx-drizzle": "workspace:*"
  },
  "devDependencies": {
    "@croco/problems-core": "workspace:*",
    "@croco/testing": "workspace:*",
    "drizzle-orm": "catalog:",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
