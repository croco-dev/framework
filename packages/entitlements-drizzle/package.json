{
  "name": "@croco/entitlements-drizzle",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/billing-core": "workspace:*",
    "@croco/entitlements-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/tx-drizzle": "workspace:*"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
