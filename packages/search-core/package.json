{
  "name": "@croco/search-core",
  "version": "0.0.3",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ko": {
      "types": "./dist/ko/index.d.ts",
      "import": "./dist/ko/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./ko": {
        "import": "./dist/ko/index.js",
        "types": "./dist/ko/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/ko/index.ts --format esm --dts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "@croco/events-core": "workspace:*"
  }
}
