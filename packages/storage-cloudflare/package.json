{
  "name": "@croco/storage-cloudflare",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/storage-cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run --exclude src/tests/CloudflareImagesLiveSmoke.spec.ts",
    "test:live": "vitest run src/tests/CloudflareImagesLiveSmoke.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/diagnostics-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/storage-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/testing": "workspace:*"
  }
}
