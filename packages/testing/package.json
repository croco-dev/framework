{
  "name": "@croco/testing",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./drizzle": {
        "import": "./dist/drizzle.mjs",
        "require": "./dist/drizzle.js",
        "types": "./dist/drizzle.d.ts"
      },
      "./playwright-reporter": {
        "types": "./dist/playwright-reporter.d.ts",
        "import": "./dist/playwright-reporter.mjs",
        "require": "./dist/playwright-reporter.js"
      },
      "./vitest-reporter": {
        "types": "./dist/vitest-reporter.d.ts",
        "import": "./dist/vitest-reporter.mjs",
        "require": "./dist/vitest-reporter.js"
      },
      "./schemas/test-evidence-v1.json": "./dist/schemas/test-evidence-v1.schema.json",
      "./schemas/test-evidence-bundle-v1.json": "./dist/schemas/test-evidence-bundle-v1.schema.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/drizzle.ts src/executable-assurance.ts src/playwright-reporter.ts src/vitest-reporter.ts --format esm,cjs --minify --clean --dts && node scripts/copy-schemas.mjs",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/auth-core": "workspace:*",
    "@croco/billing-core": "workspace:*",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/events-core": "workspace:*",
    "@croco/events-inmemory": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/framework-routes": "workspace:*",
    "@croco/llm-core": "workspace:*",
    "@croco/openapi-spec": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/ratelimit-core": "workspace:*",
    "@croco/storage-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@croco/protocols-rest": "workspace:*",
    "@croco/retry-core": "workspace:*",
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  }
}
