{
  "name": "@croco/admin-core",
  "version": "0.0.1",
  "description": "UI-agnostic admin resource and action contracts for Croco admin surfaces",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/admin-core"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./fact-history-validation": {
      "types": "./dist/fact-history-validation.d.ts",
      "import": "./dist/fact-history-validation.mjs",
      "require": "./dist/fact-history-validation.js"
    },
    "./fact-history-operations": {
      "types": "./dist/fact-history-operations.d.ts",
      "import": "./dist/fact-history-operations.mjs",
      "require": "./dist/fact-history-operations.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./fact-history-validation": {
        "types": "./dist/fact-history-validation.d.ts",
        "import": "./dist/fact-history-validation.mjs",
        "require": "./dist/fact-history-validation.js"
      },
      "./fact-history-operations": {
        "types": "./dist/fact-history-operations.d.ts",
        "import": "./dist/fact-history-operations.mjs",
        "require": "./dist/fact-history-operations.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/fact-history-validation.ts src/fact-history-operations.ts --format esm,cjs --minify --clean --dts --external @croco/admin-core/fact-history-validation",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/analytics-core": "workspace:*",
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
