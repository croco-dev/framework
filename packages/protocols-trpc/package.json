{
  "name": "@croco/protocols-trpc",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/protocols-trpc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@trpc/client": "11.17.0",
    "reflect-metadata": "^0.2.2"
  }
}
