{
  "name": "@croco/access-drizzle",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/access-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@croco/access-core": "workspace:*",
    "@croco/framework-context": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "catalog:",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
