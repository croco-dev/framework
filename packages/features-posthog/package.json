{
  "name": "@croco/features-posthog",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/features-core": "workspace:*",
    "@croco/integrations-posthog": "workspace:*"
  },
  "devDependencies": {
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
