{
  "name": "@croco/tenant-core",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/tenant-core"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "tenant-model": [
        "src/tenant-model.ts",
        "dist/tenant-model.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tenant-model": {
      "types": "./dist/tenant-model.d.ts",
      "import": "./dist/tenant-model.mjs",
      "require": "./dist/tenant-model.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./tenant-model": {
        "import": "./dist/tenant-model.mjs",
        "require": "./dist/tenant-model.js",
        "types": "./dist/tenant-model.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/tenant-model.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/access-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*"
  },
  "devDependencies": {}
}
