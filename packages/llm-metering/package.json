{
  "name": "@croco/llm-metering",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/llm-core": "workspace:*",
    "@croco/metering-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*",
    "@croco/framework-context": "workspace:*"
  },
  "peerDependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/llm-core": "workspace:*",
    "@croco/metering-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsup": "8.5.1",
    "vitest": "4.0.16"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts"
}
