        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint **/*.ts*"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "next": "15.1.2",
    "@croco/eslint-config": "workspace:*",
    "@croco/utils-tsconfig": "workspace:*"
  },
  "publishConfig": {
