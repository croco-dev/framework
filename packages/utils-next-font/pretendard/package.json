{
  "name": "@croco/utils-next-font-pretendard",
  "version": "0.0.3",
  "type": "commonjs",
  "files": ["dist", "PretendardVariable.woff2"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "import": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "require": {
