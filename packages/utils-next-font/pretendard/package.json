    "typecheck": "node ../../../node_modules/typescript/bin/tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^15 || ^16"
  },
  "devDependencies": {
    "@croco/utils-tsconfig": "workspace:*",
    "@rollup/plugin-typescript": "12.1.4",
    "next": "16.1.1",
    "react": "19.1.1",
    "rollup": "4.52.4"
