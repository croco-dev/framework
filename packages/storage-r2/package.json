{
  "name": "@croco/storage-r2",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/storage-r2"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./workers": {
      "types": {
        "import": "./dist/workers.d.mts",
        "require": "./dist/workers.d.ts"
      },
      "import": "./dist/workers.mjs",
      "require": "./dist/workers.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./workers": {
        "types": {
          "import": "./dist/workers.d.mts",
          "require": "./dist/workers.d.ts"
        },
        "import": "./dist/workers.mjs",
        "require": "./dist/workers.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/workers.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run --exclude src/tests/R2LiveSmoke.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:live": "vitest run src/tests/R2LiveSmoke.spec.ts",
    "typecheck": "tsrs --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@cloudflare/workers-types": "4.20260316.1",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/framework-config": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/retry-core": "workspace:*",
    "@croco/storage-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/testing": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "0.27.7",
    "miniflare": "4.20260312.0"
  }
}
