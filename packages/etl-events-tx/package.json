{
  "name": "@croco/etl-events-tx",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/etl-events-tx"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "import": "./src/postgres.ts",
      "require": "./src/postgres.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./postgres": {
        "types": {
          "import": "./dist/postgres.d.mts",
          "require": "./dist/postgres.d.ts"
        },
        "import": "./dist/postgres.mjs",
        "require": "./dist/postgres.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/postgres.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/tests/OutboxFactSource.integration.spec.ts",
    "test:integration": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/OutboxFactSource.integration.spec.ts",
    "test:real": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/OutboxFactSource.integration.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/etl-core": "workspace:*",
    "@croco/events-tx": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/warehouse-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/events-core": "workspace:*",
    "@croco/testing-resources": "workspace:*",
    "@croco/tx-core": "workspace:*",
    "@croco/tx-drizzle": "workspace:*",
    "@croco/warehouse-postgres": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-orm": "catalog:",
    "pg": "8.22.0",
    "tsup": "^8.4.0",
    "vitest": "4.1.8"
  }
}
