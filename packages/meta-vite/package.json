{
  "name": "@croco/meta-vite",
  "version": "0.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/meta-vite"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./isr/adapters": {
        "import": "./dist/libs/isr/adapters/index.mjs",
        "require": "./dist/libs/isr/adapters/index.js",
        "types": "./dist/libs/isr/adapters/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/libs/isr/adapters/index.ts --format esm,cjs --minify --clean --dts --external vite --external react --external react-dom --external 'react-dom/*' --external '@croco/cache-core' --external '@croco/problems-core'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/cache-core": "workspace:*",
    "@croco/presentation-preset": "workspace:*",
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "^0.5.0",
    "ioredis": "5.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.4.3",
    "vitest": "4.1.8",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "ioredis": "5.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.4.3",
    "zod": "^3.23.8"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  }
}
