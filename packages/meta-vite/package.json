{
  "name": "@croco/meta-vite",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts --external vite --external react --external react-dom --external 'react-dom/*' --external '@croco/cache-core'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@croco/cache-core": "workspace:*",
    "@croco/presentation-preset": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-rsc": "^0.5.0",
    "ioredis": "5.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "vitest": "4.0.16",
    "zod": "^3.23.8"
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
