{
  "name": "@croco/meta-vite",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/meta-vite"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./isr/adapters": {
        "types": {
          "import": "./dist/libs/isr/adapters/index.d.mts",
          "require": "./dist/libs/isr/adapters/index.d.ts"
        },
        "import": "./dist/libs/isr/adapters/index.mjs",
        "require": "./dist/libs/isr/adapters/index.js"
      },
      "./rsc/encoder": {
        "types": {
          "import": "./dist/libs/rsc/flightEncode.entry.d.mts",
          "require": "./dist/libs/rsc/flightEncode.entry.d.ts"
        },
        "import": "./dist/libs/rsc/flightEncode.entry.mjs",
        "require": "./dist/libs/rsc/flightEncode.entry.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/libs/isr/adapters/index.ts src/libs/rsc/flightEncode.entry.ts --format esm,cjs --minify --clean --dts --external vite --external react --external react-dom --external 'react-dom/*' --external 'react-server-dom-webpack/*' --external '@croco/cache-core' --external '@croco/problems-core' --external '@vitejs/plugin-rsc' --external '@vitejs/plugin-rsc/*'",
    "test": "vitest run --exclude src/tests/published-contract.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:published": "vitest run src/tests/published-contract.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/cache-core": "workspace:*",
    "@croco/presentation-preset": "workspace:*",
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "^0.5.0",
    "ioredis": "5.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "19.2.5",
    "vite": "^6.4.3",
    "vitest": "4.1.8",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@vitejs/plugin-rsc": "^0.5.0",
    "ioredis": "5.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "19.2.5",
    "vite": "^6.4.3",
    "zod": "^3.23.8"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-rsc": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "react-server-dom-webpack": {
      "optional": true
    }
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  }
}
