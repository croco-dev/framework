{
  "name": "@croco/tx-drizzle",
  "version": "0.0.3",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/repository-core": "workspace:*",
    "@croco/tx-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/dataloader-core": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
