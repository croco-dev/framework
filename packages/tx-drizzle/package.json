{
  "name": "@croco/tx-drizzle",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/tx-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./hyperdrive": {
        "types": {
          "import": "./dist/hyperdrive.d.mts",
          "require": "./dist/hyperdrive.d.ts"
        },
        "import": "./dist/hyperdrive.mjs",
        "require": "./dist/hyperdrive.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/hyperdrive.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts",
    "test:workers": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/HyperdriveWorkers.postgres.spec.ts"
  },
  "dependencies": {
    "@croco/diagnostics-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/framework-module": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/repository-core": "workspace:*",
    "@croco/tx-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/dataloader-core": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/pg": "8.20.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "catalog:",
    "esbuild": "0.27.2",
    "miniflare": "4.20260312.0",
    "pg": "8.22.0",
    "testcontainers": "12.0.4"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:",
    "pg": ">=8.16.3 <9"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
