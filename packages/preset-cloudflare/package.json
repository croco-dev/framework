{
  "name": "@croco/preset-cloudflare",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/preset-cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./application": "./src/application.ts",
    "./fetch": "./src/fetch.ts",
    "./scheduled": "./src/scheduled.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./application": {
        "types": "./dist/application.d.mts",
        "import": "./dist/application.mjs",
        "default": "./dist/application.mjs"
      },
      "./fetch": {
        "types": "./dist/fetch.d.mts",
        "import": "./dist/fetch.mjs"
      },
      "./scheduled": {
        "types": "./dist/scheduled.d.mts",
        "import": "./dist/scheduled.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp dist/index.d.mts dist/index.d.ts && cp dist/fetch.d.mts dist/fetch.d.ts",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsrs --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/execution-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-module": "workspace:*",
    "@croco/framework-preset": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/tasks-core": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "@croco/triggers-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "miniflare": "4.20260312.0",
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  }
}
