{
  "name": "@croco/presentation-preset",
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/presentation-preset"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./runtime-profiles.json": "./dist/runtime-profiles.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/framework-preset": "workspace:*"
  },
  "devDependencies": {
    "@croco/preset-cloudflare": "workspace:*",
    "@croco/preset-lambda": "workspace:*",
    "@croco/preset-node": "workspace:*",
    "tsup": "8.5.1",
    "vitest": "4.0.16"
  }
}
