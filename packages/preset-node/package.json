{
  "name": "@croco/preset-node",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      },
      "./entry": {
        "import": "./dist/entry.js",
        "require": "./dist/entry.cjs",
        "types": "./dist/entry.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/framework-preset": "workspace:*",
    "@hono/node-server": "^1.0.0",
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "vitest": "4.0.16"
  }
}
