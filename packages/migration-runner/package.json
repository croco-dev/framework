{
  "name": "@croco/migration-runner",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "migrate": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*",
    "commander": "^11.0.0",
    "drizzle-orm": ">=0.45.2"
  },
  "devDependencies": {
    "@croco/utils-tsconfig": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22",
    "better-sqlite3": "^11.10.0",
    "pg": "^8.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "migrate": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      },
      "./cli": {
        "import": "./dist/cli.js",
        "require": "./dist/cli.cjs",
        "types": "./dist/cli.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
