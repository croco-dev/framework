{
  "name": "@croco/migration-runner",
  "version": "0.0.3",
  "bin": {
    "migrate": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "bin": {
      "migrate": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./cli": {
        "import": "./dist/cli.mjs",
        "require": "./dist/cli.js",
        "types": "./dist/cli.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*",
    "commander": "^11.0.0",
    "drizzle-orm": "catalog:",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22",
    "better-sqlite3": "^11.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
