{
  "name": "@croco/cli",
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/cli"
  },
  "bin": {
    "croco": "./dist/bin/croco.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./ops": {
        "import": "./dist/ops.js",
        "types": "./dist/ops.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/tests/integration/**",
    "test:e2e": "vitest run src/tests/integration",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-routes": "workspace:*",
    "@croco/migration-runner": "workspace:*",
    "@croco/openapi-spec": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/rpc-codegen": "workspace:*",
    "citty": "^0.1.6",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@croco/execution-core": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typedi": "0.10.0",
    "vitest": "^4.0.0"
  }
}
