{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@croco/desktop-codegen": ["./node_modules/@croco/desktop-codegen/src/index.ts"],
      "@croco/protocols-desktop": ["./node_modules/@croco/protocols-desktop/src/index.ts"],
      "@croco/*": ["../../packages/*/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts", "src/tests/**"],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"]
}
