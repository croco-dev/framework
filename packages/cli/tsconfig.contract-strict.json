{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "../..",
    "paths": {
      "@croco/metrics-core/runtime": ["../../packages/metrics-core/src/runtime.ts"],
      "@croco/*": ["../../packages/*/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts", "src/tests/**"],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"]
}
