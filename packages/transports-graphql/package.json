{
  "name": "@croco/transports-graphql",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-graphql": "workspace:*",
    "graphql-yoga": "^5.10.1",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
