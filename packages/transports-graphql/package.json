{
  "name": "@croco/transports-graphql",
  "version": "0.0.3",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-graphql": "workspace:*",
    "class-validator": "^0.14.3",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.3"
  },
  "devDependencies": {}
}
