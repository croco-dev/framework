{
  "name": "@croco/events-inmemory",
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "deploy": "pnpm run build && pnpm publish --no-git-checks",
    "lint": "eslint **/*.ts*",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@croco/eslint-config": "workspace:*",
    "@croco/utils-tsconfig": "workspace:*",
    "typedi": "0.10.0"
  },
  "dependencies": {
    "@croco/events-core": "workspace:*"
  },
  "peerDependencies": {
    "typedi": "0.10.0"
  },
  "publishConfig": {
    "access": "public",
    "files": [
      "dist"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "exports": {
      ".": {
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  }
}
