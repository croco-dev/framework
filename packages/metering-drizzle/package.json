{
  "name": "@croco/metering-drizzle",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "migrate:up": "migrate up",
    "migrate:status": "migrate status",
    "migrate:down": "migrate down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@croco/metering-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/tx-core": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@croco/migration-runner": "workspace:*",
    "@croco/tx-drizzle": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "ulid": "^3.0.2",
    "vitest": "4.0.16"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
