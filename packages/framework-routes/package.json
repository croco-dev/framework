{
  "name": "@croco/framework-routes",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup && node scripts/generate-routes.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@croco/protocols-core": "workspace:*",
    "tsup": "8.5.1",
    "vitest": "4.0.16"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "files": [
    "dist"
  ]
}
