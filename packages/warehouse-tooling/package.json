{
  "name": "@croco/warehouse-tooling",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/warehouse-tooling"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./offline": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "example:build": "tsup --config examples/tsup.config.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:watch": "vitest",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/etl-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/warehouse-core": "workspace:*",
    "@croco/warehouse-postgres": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  }
}
