{
  "name": "@croco/frontend-react",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/frontend-react"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./experience-slot": "./src/experience-slot.ts",
    "./surveys": "./src/surveys.ts",
    "./experiments": "./src/experiments.ts",
    "./acquisition": "./src/acquisition.ts",
    "./apollo": "./src/apollo.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": {
          "import": "./dist/index.d.mts",
          "require": "./dist/index.d.ts"
        },
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./experience-slot": {
        "types": {
          "import": "./dist/experience-slot.d.mts",
          "require": "./dist/experience-slot.d.ts"
        },
        "import": "./dist/experience-slot.mjs",
        "require": "./dist/experience-slot.js"
      },
      "./surveys": {
        "types": {
          "import": "./dist/surveys.d.mts",
          "require": "./dist/surveys.d.ts"
        },
        "import": "./dist/surveys.mjs",
        "require": "./dist/surveys.js"
      },
      "./experiments": {
        "types": {
          "import": "./dist/experiments.d.mts",
          "require": "./dist/experiments.d.ts"
        },
        "import": "./dist/experiments.mjs",
        "require": "./dist/experiments.js"
      },
      "./acquisition": {
        "types": {
          "import": "./dist/acquisition.d.mts",
          "require": "./dist/acquisition.d.ts"
        },
        "import": "./dist/acquisition.mjs",
        "require": "./dist/acquisition.js"
      },
      "./apollo": {
        "types": {
          "import": "./dist/apollo.d.mts",
          "require": "./dist/apollo.d.ts"
        },
        "import": "./dist/apollo.mjs",
        "require": "./dist/apollo.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/apollo.ts src/index.ts src/acquisition.ts src/experience-slot.ts src/surveys.ts src/experiments.ts --format esm,cjs --minify --clean --dts --external react --external react-dom --external @croco/meta-vite --external @croco/problems-core --external @croco/onboarding-core --external @croco/promotions-core --external @croco/gamification-core --external @croco/referral-core --external @apollo/client --external @apollo/client/*",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/billing-core": "workspace:*",
    "@croco/experience-core": "workspace:*",
    "@croco/gamification-core": "workspace:*",
    "@croco/meta-vite": "workspace:*",
    "@croco/onboarding-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/promotions-core": "workspace:*",
    "@croco/referral-core": "workspace:*",
    "@croco/research-core": "workspace:*"
  },
  "devDependencies": {
    "@apollo/client": "4.3.3",
    "@croco/meta-vite": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "graphql": "^16.12.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rxjs": "^7.8.2",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@apollo/client": "^4.3.3",
    "@croco/meta-vite": "workspace:*",
    "graphql": "^16.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts",
      "src/**/*.spec.tsx"
    ]
  }
}
