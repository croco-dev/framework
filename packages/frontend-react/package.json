{
  "name": "@croco/frontend-react",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/frontend-react"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts --external react --external react-dom --external @croco/meta-vite --external @croco/problems-core",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@croco/meta-vite": "workspace:*",
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "@croco/meta-vite": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "@croco/meta-vite": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts",
      "src/**/*.spec.tsx"
    ]
  }
}
